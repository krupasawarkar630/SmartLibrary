<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="90dp">

        <!-- HEADER USER GREETING -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/imgHomeProfile"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to the Library,"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/tvHomeUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Smart Student"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Find something worth reading today."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgHomeProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Profile Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:cornerSize="50%"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />
        </RelativeLayout>

        <!-- SEARCH BAR (Minimal) -->
        <LinearLayout
            android:id="@+id/cardHomeSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvHomeSearchPlaceholder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Search catalog..."
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnHomeScanQr"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Scan QR"
                android:src="@drawable/ic_qr_scan"
                app:tint="@color/primary" />
        </LinearLayout>

        <!-- PROMO SLIDER -->
        <HorizontalScrollView
            android:id="@+id/promoSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- BANNER 1: AI ASSISTANT -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bannerAiAssistant"
                    android:layout_width="310dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/slider_img_ai" />
                            
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#88000000" />
                            
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="24dp">
                            
                            <TextView
                                android:id="@+id/tvBanner1Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✨ NEW FEATURE"
                                android:textColor="#A8D8D6"
                                android:textSize="11sp"
                                android:letterSpacing="0.1"
                                android:textStyle="bold"
                                android:textAllCaps="true" />
                                
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Meet your new\nAI Librarian"
                                android:textColor="@color/surface"
                                android:lineSpacingExtra="4dp"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BANNER 2: NEW ARRIVALS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bannerNewArrivals"
                    android:layout_width="310dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/slider_img_books" />
                            
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#77000000" />
                            
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="24dp">
                            
                            <TextView
                                android:id="@+id/tvBanner2Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔥 WEEKLY HIGHLIGHTS"
                                android:textColor="#FFE5C4"
                                android:textSize="11sp"
                                android:letterSpacing="0.1"
                                android:textStyle="bold"
                                android:textAllCaps="true" />
                                
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Explore this week's\ntop reads"
                                android:textColor="@color/surface"
                                android:lineSpacingExtra="4dp"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BANNER 3: DIGITAL PASS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bannerDigitalPass"
                    android:layout_width="310dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/slider_img_digital" />
                            
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#88000000" />
                            
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="24dp">
                            
                            <TextView
                                android:id="@+id/tvBanner3Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📱 QUICK ACCESS"
                                android:textColor="#A2DBC2"
                                android:textSize="11sp"
                                android:letterSpacing="0.1"
                                android:textStyle="bold"
                                android:textAllCaps="true" />
                                
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Scan QR for\ninstant checkout"
                                android:textColor="@color/surface"
                                android:lineSpacingExtra="4dp"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
                
            </LinearLayout>
        </HorizontalScrollView>

        <!-- CONTINUE READING (Minimal) -->
        <LinearLayout
            android:id="@+id/layoutContinueReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="40dp"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Currently Reading"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
                
            <LinearLayout
                android:id="@+id/cardContinueReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="110dp"
                    app:cardCornerRadius="2dp"
                    app:cardElevation="2dp">
                    <ImageView
                        android:id="@+id/imgContinueCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_book" />
                </com.google.android.material.card.MaterialCardView>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/tvContinueTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book Title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>
                        
                    <TextView
                        android:id="@+id/tvContinueAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Author"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                        
                    <TextView
                        android:id="@+id/tvContinueStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Borrowed"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- DASHBOARD REMOVED / MINIMAL OVERVIEW -->
        <LinearLayout
            android:id="@+id/layoutDashboardOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="40dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIssuedBooks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatIssuedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Borrowed"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:maxLines="1"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatPendingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Requests"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:maxLines="1"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <View
                android:layout_width="8dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLibraryLocations"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatLocationsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Branches"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:maxLines="1"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Hidden view so Java code doesn't crash for missing IDs -->
            <View android:id="@+id/cardAvailableBooks" android:layout_width="0dp" android:layout_height="0dp"/>
            <TextView android:id="@+id/tvStatAvailableCount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp" />

        <!-- SMART PICKS / RECENT BOOKS -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="New Additions"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAllBooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingVertical="4dp"
                android:text="View Catalog"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentBooks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- CATEGORIES HORIZONTAL RECYCLERVIEW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="24dp"
            android:text="Browse by Subject"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
